# Supabase — públicas (protegidas por RLS, seguro expor no frontend).
# Publishable Key (padrão atual do Supabase, formato sb_publishable_...) — não é a Secret Key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# APIs externas — SOMENTE server-side (nunca prefixar com NEXT_PUBLIC_).
# Sem elas, a Biblioteca funciona em modo manual (sem busca de capa/poster automática).
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
